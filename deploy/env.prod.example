# انسخه إلى .env.prod في جذر المشروع (اسمه هنا بلا نقطة كي لا يحجبه .gitignore) — و.env* محجوب في .gitignore

JISR_DOMAIN=jisr.example.com
APP_VERSION=0.1.0
LOG_LEVEL=info

POSTGRES_USER=jisr
POSTGRES_DB=jisr
# openssl rand -base64 32
POSTGRES_PASSWORD=

# 32 محرفاً على الأقل — openssl rand -base64 32
JWT_SECRET=

# مفتاح تشفير أسرار التكاملات — openssl rand -base64 32
# ⚠️ فقدانه يعني فقدان كل الحسابات المربوطة. احفظه خارج الخادم أيضاً.
SECRETS_KEY_VERSION=1
SECRETS_KEY_V1=
# أثناء التدوير: أضف V2، انقل SECRETS_KEY_VERSION إليه، وأبقِ V1 حتى
# تُعاد كتابة كل الحسابات (راجع docs/runbook.md)
SECRETS_KEY_V2=

HISTORY_RETENTION_DAYS=90
STATE_POLL_INTERVAL_SECONDS=0
BACKUP_KEEP_DAYS=14
