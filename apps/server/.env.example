# ── الشبكة ──
PORT=3000
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# يظهر في /health وفي عقد OpenAPI
APP_VERSION=0.0.0

# ── قاعدة البيانات (ADR-0013) ──
# للتطوير: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://jisr:jisr_dev@localhost:5432/jisr

# ── المصادقة (ADR-0009: الهاتف لا يحمل أي سرّ) ──
# ولّده بـ: openssl rand -base64 32
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── تشفير أسرار التكاملات — AES-256-GCM (الهيكلية § 7) ──
# مفتاح لكل نسخة؛ التدوير: أضف SECRETS_KEY_V2 ثم ارفع SECRETS_KEY_VERSION
# ولّده بـ: openssl rand -base64 32
SECRETS_KEY_V1=
SECRETS_KEY_VERSION=1

# ── الحالة اللحظية والسجلّ ────────────────────────────────────────────────
# استقصاء الحالة: حلّ مؤقّت حتى يصل دفع الرسائل (P2.1). صفر = معطّل، وهو
# الافتراضي: تقصير الفترة يلتهم حصّة استدعاءات الشركة (الدراسة § 7).
STATE_POLL_INTERVAL_SECONDS=0

# مدة استبقاء السلسلة الزمنية بالأيام — ADR-0013. صفر = بلا حذف (غير موصى به).
HISTORY_RETENTION_DAYS=90
