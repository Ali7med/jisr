// مخطّط قاعدة البيانات — ADR-0013 (PostgreSQL + Prisma)
//
// ثلاثة أحمال في قاعدة واحدة: علائقي صرف (مستخدمون · حسابات · أجهزة)،
// أسرار مشفّرة AES-GCM (الهيكلية § 7)، وسلسلة زمنية (state_history).

generator client {
  provider = "prisma-client-js"
}

// عنوان الاتصال يعيش في prisma.config.ts (Prisma 7)، والعميل يأخذ محوّلاً
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts      Account[]
  refreshTokens RefreshToken[]
  automations   Automation[]
  scenes        Scene[]
  notifications Notification[]

  ownedMemberships  Membership[]    @relation("SpaceOwner")
  memberships       Membership[]    @relation("SpaceMember")
  invitations       Invitation[]    @relation("InvitationOwner")
  activityAsOwner   ActivityEntry[] @relation("ActivityOwner")
  activityAsActor   ActivityEntry[] @relation("ActivityActor")

  @@map("users")
}

/// رمز تجديد — يُخزَّن **مجزّأً** لا خاماً: تسريب القاعدة لا يمنح جلسات.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum AccountStatus {
  active
  invalid_credentials
  expired
  disabled

  @@map("account_status")
}

/// حساب مربوط بتكامل. الأسرار مشفّرة AES-GCM بمفتاح خارج القاعدة،
/// و`keyVersion` يسمح بتدوير المفتاح بلا توقّف (الهيكلية § 7).
model Account {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  integrationId String        @map("integration_id")
  label         String
  status        AccountStatus @default(active)

  secretsCipher Bytes @map("secrets_cipher")
  secretsIv     Bytes @map("secrets_iv")
  secretsTag    Bytes @map("secrets_tag")
  keyVersion    Int   @default(1) @map("key_version")

  /// انتهاء اشتراك API لدى الشركة — عليه يعمل «حارس الصلاحية» (الدراسة § 7).
  credentialsExpireAt DateTime? @map("credentials_expire_at")
  lastCheckedAt       DateTime? @map("last_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]

  @@unique([userId, integrationId, label])
  @@index([userId])
  @@index([credentialsExpireAt])
  @@map("accounts")
}

/// جهاز موحّد. `capabilities` تُخزَّن كما ترجمها التكامل — الواجهة لا
/// تعرف الشركة، والقدرة غير المفهومة تُحفظ ولا تُخفى (القاعدة 3).
model Device {
  id            String  @id @default(uuid()) @db.Uuid
  accountId     String  @map("account_id") @db.Uuid
  integrationId String  @map("integration_id")
  nativeId      String  @map("native_id")
  name          String
  category      String
  online        Boolean @default(false)
  model         String  @default("")
  productName   String  @default("") @map("product_name")
  iconUrl       String? @map("icon_url")
  room          String?
  isSubDevice   Boolean @default(false) @map("is_sub_device")
  capabilities  Json    @default("[]")

  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  history     StateHistory[]
  permissions DevicePermission[]

  @@unique([accountId, nativeId])
  @@index([accountId])
  @@map("devices")
}

/// السلسلة الزمنية. الفهرس `(device_id, recorded_at)` مقصود، والتقسيم
/// الشهري وسياسة الاستبقاء يُفعَّلان عند الحاجة — ADR-0013.
model StateHistory {
  id         BigInt   @id @default(autoincrement())
  deviceId   String   @map("device_id") @db.Uuid
  key        String
  /// القيمة العددية للرسوم؛ `rawValue` لما ليس عدداً.
  value      Float?
  rawValue   Json?    @map("raw_value")
  recordedAt DateTime @default(now()) @map("recorded_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@map("state_history")
}

// ── الأتمتة ─────────────────────────────────────────────────────────────────
// ADR-0015: المحرّك داخل العملية، والحالة الدائمة هنا لا في الذاكرة —
// إعادة تشغيل السيرفر لا تُضيّع أتمتة ولا تُكرّر تنفيذاً.

/// أتمتة واحدة: مُشغِّل + شروط + إجراءات. الأشكال تُخزَّن Json لأن العقد
/// (TypeBox) هو من يتحقّق منها، وتغييرها لا يستحق هجرة في كل مرة.
model Automation {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  name    String
  enabled Boolean @default(true)

  trigger    Json
  conditions Json @default("[]")
  actions    Json

  /// آخر تنفيذ — عليه يعمل منع التكرار في مُشغِّل الوقت.
  lastRunAt DateTime? @map("last_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([userId])
  @@index([enabled])
  @@map("automations")
}

/// سجلّ التنفيذ — يجعل «لماذا لم تعمل أتمتتي؟» سؤالاً له جواب.
model AutomationRun {
  id           BigInt   @id @default(autoincrement())
  automationId String   @map("automation_id") @db.Uuid
  succeeded    Boolean
  /// سبب عربي جاهز للعرض عند الفشل، أو ملخّص ما نُفِّذ عند النجاح.
  detail       String
  ranAt        DateTime @default(now()) @map("ran_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, ranAt])
  @@map("automation_runs")
}

/// مشهد: مجموعة أوامر تُنفَّذ بنقرة — **عابر للشركات** بطبيعته، لأن
/// الأوامر تُوجَّه بمعرّف العقد المركّب لا بمعرّف شركة.
model Scene {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  name   String
  icon   String @default("")
  steps  Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("scenes")
}

/// إشعار داخل التطبيق. يصل لحظياً عبر القناة، ويبقى في القاعدة كي يراه
/// من كان هاتفه مغلقاً — دفع FCM يُبنى فوقه في P5.3 لا بدلاً منه.
model Notification {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  title    String
  body     String
  severity String    @default("info")
  readAt   DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ── العائلة والصلاحيات (P6) ─────────────────────────────────────────────────
// نموذج «المساحة»: أجهزة كل مستخدم تعيش في مساحته، وقد يدعو غيره إليها.
// لا كيان «منزل» منفصل: المالك هو المساحة، وهذا يكفي حتى يثبت العكس.

enum MemberRole {
  owner
  member

  @@map("member_role")
}

/// عضوية شخص في مساحة مالك. **المنع هو الأصل**: عضو لا يرى إلا ما مُنح.
model Membership {
  id       String     @id @default(uuid()) @db.Uuid
  ownerId  String     @map("owner_id") @db.Uuid
  memberId String     @map("member_id") @db.Uuid
  role     MemberRole @default(member)
  label    String     @default("")

  createdAt DateTime @default(now()) @map("created_at")

  owner  User @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member User @relation("SpaceMember", fields: [memberId], references: [id], onDelete: Cascade)

  permissions DevicePermission[]

  @@unique([ownerId, memberId])
  @@index([memberId])
  @@map("memberships")
}

/// إذن عضو على جهاز بعينه. وجود الصف يعني «يرى»، و`canControl` يعني «يتحكّم».
model DevicePermission {
  id           String  @id @default(uuid()) @db.Uuid
  membershipId String  @map("membership_id") @db.Uuid
  deviceId     String  @map("device_id") @db.Uuid
  canControl   Boolean @default(false) @map("can_control")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([membershipId, deviceId])
  @@index([deviceId])
  @@map("device_permissions")
}

/// دعوة بالبريد. الرمز يُخزَّن **مجزّأً** كرمز التجديد: تسريب القاعدة
/// لا يمنح دخولاً إلى مساحة أحد.
model Invitation {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash")
  label     String    @default("")
  expiresAt DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  owner User @relation("InvitationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([email])
  @@map("invitations")
}

/// سجلّ نشاط: مَن فعل ماذا ومتى. يُكتب لكل فعل تحكّم، بما فيه أفعال المالك.
model ActivityEntry {
  id       BigInt  @id @default(autoincrement())
  ownerId  String  @map("owner_id") @db.Uuid
  actorId  String  @map("actor_id") @db.Uuid
  deviceId String? @map("device_id")
  action   String
  detail   String  @default("")

  at DateTime @default(now())

  owner User @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([ownerId, at])
  @@map("activity_log")
}
