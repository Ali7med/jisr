{
  "name": "@jisr/server",
  "version": "0.0.0",
  "private": true,
  "description": "سيرفر جسر — Fastify (ADR-0008)",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "node --experimental-strip-types scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@jisr/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
